#!/bin/bash

validateNums(){
 validChars="$(echo $1 | sed -e 's/[^0-9]//g')"

    if [[ "$validChars" = "$1" ]]; then
      echo "VALID: $validChars"
      #return 0
    else
      echo "Invalid"
      #return 1
    fi
}

validateAlphaNumeric(){
 validChars="$(sed -e 's/[^[:alnum:]]//g'<<< "$1")"
    if [[ "$validChars" = "$1" ]]; then
      echo "VALID: $validChars"
      #return 0
    else
      echo "Invalid"
      #return 1
    fi
  }

